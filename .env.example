# 兩個服務共用的環境變數範本(各自部署時分別設定)
# Secrets 一律放 GCP Secret Manager、不要放進版控

# Vertex AI
VERTEX_PROJECT=your-gcp-project
VERTEX_LOCATION=us-central1
VERTEX_CHAT_MODEL=gemini-3.1-pro-preview

# LINE Messaging API
LINE_TOKEN=
LINE_SECRET=
LINE_GROUP_ID=          # aibao 專用:白名單鎖定的家族群 ID

# 行為設定
TRIGGER_KEYWORD=阿寶     # aibao 專用:群組裡叫這個名字才回話
WEATHER_REGION=台北市    # aibao 早報的天氣地區、照家人實際所在地設

# 排程與提醒(Cloud Tasks / Cloud Scheduler)
SCHEDULER_SECRET=
SERVICE_URL=
TASKS_QUEUE=
TASKS_LOCATION=us-central1

PORT=8080
